endpoint         = "https://192.168.1.100:8006"
proxmox_username = "root@pam"
main_password    = "CHANGE_ME_PROXMOX_PASSWORD"
vm_pass          = "CHANGE_ME_VM_PASSWORD"
pc_public_key_path = "/home/user/.ssh/id_ed25519.pub"

images = {
  ubuntu_jammy = {
    datastore_id = "local"
    node_name    = "pve"
    url          = "https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img"
    file_name    = "jammy-server-cloudimg-amd64.qcow2"
  }
}

vm_groups = {
  app = {
    count       = 3
    vm_id_start = 4301
    name_prefix = "app-vm"
    config = {
      image_key                   = "ubuntu_jammy"
      node_name                   = "pve"
      agent_enabled               = true
      tags                        = ["terraform", "ubuntu", "app"]
      disk_datastore_id           = "local-zfs"
      initialization_datastore_id = "local-zfs"
      bridge                      = "vmbr0"
    }
  }
}

vms = {}
